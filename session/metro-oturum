#!/bin/sh
# MetroThemePlasma Wayland oturumu. Tema anahtarlarının değiştirilmesi
# ~/.config/plasma-workspace/env/metrothemeplasma.sh içinde (metro-profil) yapılır.
export PLASMA_DEFAULT_SHELL=io.github.yyozcan.metroshell
export METROTHEMEPLASMA_SESSION=1
# Metro varsayılanları ve oturuma özgü otomatik başlatma (metro-kabuk)
export XDG_CONFIG_DIRS="$HOME/.local/share/metrothemeplasma/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"
# yalnızca Metro oturumunda görünen programlar
export XDG_DATA_DIRS="$HOME/.local/share/metrothemeplasma/data:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# Windows 8 ekran göstergesi (ses/parlaklık): Plasma'nın org.kde.plasma.workspace.osd modülünü gölgeler
export QML_IMPORT_PATH="$HOME/.local/share/metrothemeplasma/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
# Windows 8 bildirimleri (derlenmiş Plasma uygulamacığı, yalnızca bu oturumda)
export QT_PLUGIN_PATH="$HOME/.local/share/metrothemeplasma/eklenti${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
# Windows 8.1'in kendi Segoe UI ailesi (yalnızca bu oturumda)
[ -f "$HOME/.local/share/metrothemeplasma/fonts.conf" ] && export FONTCONFIG_FILE="$HOME/.local/share/metrothemeplasma/fonts.conf"
/usr/lib/plasma-dbus-run-session-if-needed /usr/bin/startplasma-wayland
# düzgün oturum kapatmada önceki temayı hemen geri yükle
[ -x "$HOME/.local/bin/metro-profil" ] && "$HOME/.local/bin/metro-profil" geri >/dev/null 2>&1
exit 0
