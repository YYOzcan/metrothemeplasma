[Desktop Entry]
Type=Service
MimeType=application/x-desktop;
Actions=baslangicaSabitle
X-KDE-Priority=TopLevel
X-KDE-RequiredNumberOfUrls=1

[Desktop Action baslangicaSabitle]
Name=Başlangıç ekranına sabitle
Name[tr]=Başlangıç ekranına sabitle
Icon=start-here
Exec=qdbus6 io.github.yyozcan.MetroKabuk /Kabuk io.github.yyozcan.MetroKabuk.BaslangicaSabitle %f
