# MetroThemePlasma: kapatırken/yeniden başlatırken metin konsoluna "The system will power off/reboot now!"
# duyurusu yazılmasın (oturum kapanınca o siyah ekranda görünüyordu); Windows 8.1 kapanış ekranı doğrudan gelir.
[Unit]
Description=MetroThemePlasma: kapanış duyurularını sustur
After=systemd-logind.service
Requires=systemd-logind.service

[Service]
Type=oneshot
ExecStart=/usr/bin/busctl set-property org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager EnableWallMessages b false
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
