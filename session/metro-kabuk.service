[Unit]
Description=Metro Kabuğu (MetroThemePlasma: Başlangıç ekranı, tılsımlar)
# yalnızca MetroThemePlasma oturumunda (DESKTOP_SESSION her oturum açılışında yeniden yazılır)
PartOf=graphical-session.target
After=plasma-kwin_wayland.service plasma-plasmashell.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=dbus
BusName=io.github.yyozcan.MetroKabuk
ExecCondition=/bin/sh -c 'test "$DESKTOP_SESSION" = metrothemeplasma'
ExecStart=@BIN@/metro-kabuk --giris
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=plasma-workspace.target
