@@ -142,6 +145,26 @@ inline void About::initializeBrandingInfo()
     brandingInfo[WIN_8_9600].showMemory = false;
     brandingInfo[WIN_8_9600].license = brandingInfo[WIN_VISTA].license;
 
+    // MetroThemePlasma: kendi Windows 8.1 kopyandan (basebrd.dll, shell32.dll.mui) üretilen marka bilgisi
+    {
+        const QString ini = QStandardPaths::locate(QStandardPaths::GenericDataLocation, QStringLiteral("metrothemeplasma/varlik/winver.ini"));
+        if (!ini.isEmpty()) {
+            QSettings m(ini, QSettings::IniFormat);
+            m.beginGroup(QStringLiteral("Windows81"));
+            auto &b = brandingInfo[WIN_8_9600];
+            b.windowTitle = m.value(QStringLiteral("baslik"), b.windowTitle).toString();
+            b.brandingPath = m.value(QStringLiteral("marka"), b.brandingPath).toString();
+            if (!b.brandingPath.startsWith(QLatin1Char(':')) && QFileInfo(b.brandingPath).isRelative())
+                b.brandingPath = QFileInfo(ini).absolutePath() + QLatin1Char('/') + b.brandingPath;
+            b.osName = m.value(QStringLiteral("urun"), b.osName).toString();
+            b.version = m.value(QStringLiteral("surum"), b.version).toString();
+            b.copyright = m.value(QStringLiteral("telif"), b.copyright).toString();
+            b.winverName = m.value(QStringLiteral("ad"), b.winverName).toString();
+            b.license = m.value(QStringLiteral("lisans"), b.license).toString();
+            longTextTemplate = m.value(QStringLiteral("uzun"), QString()).toString();
+        }
+    }
+
     // Custom
     brandingInfo[CUSTOM].windowTitle = settings.value("windowTitle", "undefined").toString();
     brandingInfo[CUSTOM].windowWidth = settings.value("windowWidth", 458).toInt();
